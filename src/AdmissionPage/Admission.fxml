<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" 
            style="-fx-background-color: #f8fafc;" 
            xmlns="http://javafx.com/javafx/26" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="AdmissionPage.AdmissionController">

    <!-- ================= TOP NAVIGATION ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" 
              prefHeight="60.0" 
              spacing="20.0" 
              style="-fx-background-color: #1565C0; -fx-border-color: #c5c7bc; -fx-border-width: 0 0 2 0;">

            <padding>
                <Insets bottom="8.0" left="10.0" right="20.0" top="8.0" />
            </padding>

            <!-- Logo -->
            <ImageView fitHeight="56.0" fitWidth="70.0" preserveRatio="true">
                <image>
                    <Image url="@images/klnclg_logo.jpg" />
                </image>
            </ImageView>

            <!-- Title - Grows to fill space -->
            <Label alignment="CENTER" 
                   contentDisplay="CENTER" 
                   maxWidth="1.7976931348623157E308" 
                   text="STUDENT MANAGEMENT SYSTEM" 
                   textFill="WHITE" 
                   HBox.hgrow="ALWAYS">
                <font>
                    <Font name="System Bold Italic" size="24.0" />
                </font>
            </Label>

            <!-- Logout -->
            <Button onAction="#navigatetoLogin" 
                    prefHeight="45.0" 
                    prefWidth="140.0" 
                    style="-fx-background-color: #d5d5d5; -fx-font-size: 18px; -fx-text-fill: #1F2937; -fx-background-radius: 6; -fx-cursor: hand;" 
                    text="Logout" />

        </HBox>
    </top>

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox prefWidth="250.0" 
              spacing="5.0" 
              style="-fx-background-color: #1565C0; -fx-border-color: #d0d0d0; -fx-border-width: 0 1 0 0;">

            <padding>
                <Insets left="5.0" right="5.0" top="20.0" />
            </padding>

            <!-- Dashboard -->
            <Button alignment="CENTER_LEFT" 
                    onAction="#gotoDashboard" 
                    prefHeight="50.0" 
                    prefWidth="250.0" 
                    style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-text-fill: white; -fx-cursor: hand;" 
                    text="📊  Dashboard" />

            <!-- Student Admission ACTIVE -->
            <Button alignment="CENTER_LEFT" 
                    prefHeight="50.0" 
                    prefWidth="250.0" 
                    style="-fx-background-color: #2C5EAD; -fx-font-size: 16px; -fx-text-fill: white; -fx-cursor: hand;" 
                    text="🧾  Student Admission">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Button>

            <!-- Student Records -->
            <Button alignment="CENTER_LEFT" 
                    onAction="#recordsButton" 
                    prefHeight="50.0" 
                    prefWidth="250.0" 
                    style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-text-fill: white; -fx-cursor: hand;" 
                    text="📄  Student Records">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Button>

            <!-- Timetable -->
            <Button alignment="CENTER_LEFT" 
                    onAction="#timetableButton" 
                    prefHeight="50.0" 
                    prefWidth="250.0" 
                    style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-text-fill: white; -fx-cursor: hand;" 
                    text="🕒  Timetable">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Button>

            <!-- Attendance -->
            <Button alignment="CENTER_LEFT" 
                    onAction="#attendanceButton" 
                    prefHeight="50.0" 
                    prefWidth="250.0" 
                    style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-text-fill: white; -fx-cursor: hand;" 
                    text="📅  Attendance">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Button>

        </VBox>
    </left>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true" 
                    fitToHeight="true" 
                    style="-fx-background: #f8fafc; -fx-border-color: transparent;">

            <content>
                <VBox spacing="20.0" 
                      style="-fx-padding: 25;">

                    <!-- Main White Card -->
                    <VBox spacing="18.0" 
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4);">

                        <!-- Heading -->
                        <Label style="-fx-font-size: 28px; -fx-text-fill: #1F2937;" 
                               text="Student Admission Form">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>

                        <!-- ================= BASIC INFORMATION ================= -->
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #1565C0; -fx-font-weight: bold;" 
                               text="BASIC INFORMATION" />

                        <!-- Roll + Gender -->
                        <HBox spacing="140.0">
                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="ROLL NUMBER" />
                                <TextField fx:id="rollNumber" 
                                           prefHeight="45.0" 
                                           prefWidth="420.0" 
                                           promptText="e.g. 268001" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>

                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="GENDER" />
                                <ComboBox fx:id="gender" 
                                          prefHeight="45.0" 
                                          prefWidth="250.0" 
                                          promptText="Select gender" 
                                          visibleRowCount="3" 
                                          style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Male" />
                                            <String fx:value="Female" />
                                            <String fx:value="Other" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </VBox>
                        </HBox>

                        <!-- First Name + Last Name + DOB -->
                        <HBox spacing="55.0">
                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="FIRST NAME" />
                                <TextField fx:id="firstName" 
                                           prefHeight="45.0" 
                                           prefWidth="260.0" 
                                           promptText="First name" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>

                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="LAST NAME" />
                                <TextField fx:id="lastName" 
                                           prefHeight="45.0" 
                                           prefWidth="260.0" 
                                           promptText="Last name" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>

                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="DATE OF BIRTH" />
                                <DatePicker fx:id="dateOfBirth" 
                                            prefHeight="45.0" 
                                            prefWidth="280.0" 
                                            style="-fx-background-radius: 6;" />
                            </VBox>
                        </HBox>

                        <!-- Community -->
                        <VBox spacing="8.0">
                            <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                   text="COMMUNITY" />
                            <ComboBox fx:id="community" 
                                      prefHeight="45.0" 
                                      prefWidth="220.0" 
                                      promptText="Select type" 
                                      visibleRowCount="5" 
                                      style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="OC" />
                                        <String fx:value="BC" />
                                        <String fx:value="MBC" />
                                        <String fx:value="SC" />
                                        <String fx:value="ST" />
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </VBox>

                        <!-- ================= PARENT INFORMATION ================= -->
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #1565C0; -fx-font-weight: bold;" 
                               text="PARENT INFORMATION" />

                        <!-- Parent Details -->
                        <HBox spacing="50.0">
                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="FATHER NAME" />
                                <TextField fx:id="fatherName" 
                                           prefHeight="45.0" 
                                           prefWidth="320.0" 
                                           promptText="Father's full name" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>

                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="MOTHER NAME" />
                                <TextField fx:id="motherName" 
                                           prefHeight="45.0" 
                                           prefWidth="320.0" 
                                           promptText="Mother's full name" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>

                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="PARENT OCCUPATION" />
                                <TextField fx:id="parentOccupation" 
                                           alignment="TOP_LEFT" 
                                           prefHeight="45.0" 
                                           prefWidth="308.0" 
                                           promptText="Occupation" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>
                        </HBox>

                        <!-- ================= CONTACT DETAILS ================= -->
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #1565C0; -fx-font-weight: bold;" 
                               text="CONTACT DETAILS" />

                        <!-- Contact -->
                        <HBox spacing="70.0">
                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="STUDENT CONTACT" />
                                <TextField fx:id="studentContact" 
                                           prefHeight="45.0" 
                                           prefWidth="420.0" 
                                           promptText="98765 43210" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>

                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="PARENT CONTACT" />
                                <TextField fx:id="parentContact" 
                                           prefHeight="45.0" 
                                           prefWidth="420.0" 
                                           promptText="98765 43210" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>
                        </HBox>

                        <!-- Address -->
                        <VBox spacing="8.0">
                            <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                   text="ADDRESS" />
                            <TextArea fx:id="address" 
                                      prefHeight="120.0" 
                                      prefWidth="950.0" 
                                      promptText="Enter full address..." 
                                      style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" 
                                      wrapText="true" />
                        </VBox>

                        <!-- ================= ACADEMIC DETAILS ================= -->
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #1565C0; -fx-font-weight: bold;" 
                               text="ACADEMIC DETAILS" />

                        <!-- Marks -->
                        <HBox spacing="80.0">
                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="10TH MARK %" />
                                <TextField fx:id="tenthMarkPercentage" 
                                           prefHeight="45.0" 
                                           prefWidth="180.0" 
                                           promptText="e.g. 85.5" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>

                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="12TH MARK %" />
                                <TextField fx:id="twelvethMarkPercentage" 
                                           prefHeight="45.0" 
                                           prefWidth="180.0" 
                                           promptText="e.g. 88.0" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>
                        </HBox>

                        <!-- UG Details -->
                        <HBox spacing="60.0">
                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="UG COLLEGE" />
                                <TextField fx:id="ugCollege" 
                                           prefHeight="45.0" 
                                           prefWidth="420.0" 
                                           promptText="College name" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>

                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="UG MARK %" />
                                <TextField fx:id="ugMarkPercent" 
                                           prefHeight="45.0" 
                                           prefWidth="180.0" 
                                           promptText="e.g. 82.3" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>

                            <VBox spacing="8.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #374151;" 
                                       text="YEAR PASSED" />
                                <TextField fx:id="yearPassed" 
                                           prefHeight="45.0" 
                                           prefWidth="180.0" 
                                           promptText="e.g. 2023" 
                                           style="-fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
                            </VBox>
                        </HBox>

                        <!-- Bottom Buttons -->
                        <HBox alignment="CENTER" spacing="90.0">
                            <Button fx:id="saveBtn" 
                                    onAction="#saveStudent" 
                                    prefHeight="50.0" 
                                    prefWidth="140.0" 
                                    text="Save" 
                                    style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 8; -fx-cursor: hand;" />

                            <Button fx:id="resetBtn" 
                                    onAction="#resetForm" 
                                    prefHeight="50.0" 
                                    prefWidth="140.0" 
                                    text="Reset" 
                                    style="-fx-background-color: #6B7280; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 8; -fx-cursor: hand;" />
                        </HBox>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>