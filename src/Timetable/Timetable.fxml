            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="30.0" style="-fx-padding: 20 0;">
                <Button fx:id="saveButton" 
                        onAction="#handleSave" 
                        prefHeight="50.0" 
                        prefWidth="200.0" 
                        style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" 
                        text="SAVE" />
                
                <Button fx:id="editButton" 
                        onAction="#handleEdit" 
                        prefHeight="50.0" 
                        prefWidth="200.0" 
                        style="-fx-background-color: #6B7280; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" 
                        text="EDIT" />
            </HBox>

        </VBox>
    </center>

</BorderPane>