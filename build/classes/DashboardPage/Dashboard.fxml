<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="DashboardPage.DashboardController">

    <!-- TOP NAVBAR - Anchored to top, stretches full width -->
    <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #1565C0; -fx-border-width: 0 0 2 0; -fx-border-color: #C5C7BC;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- College Logo -->
        <ImageView fitHeight="56.0" fitWidth="70.0" preserveRatio="true">
            <image>
                <Image url="@images/klnclg_logo.jpg" />
            </image>
        </ImageView>

        <!-- Title - Grows to fill space -->
        <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" text="STUDENT MANAGEMENT SYSTEM" textFill="WHITE" HBox.hgrow="ALWAYS">
            <font>
                <Font name="System Bold Italic" size="24.0" />
            </font>
        </Label>

        <!-- Logout Button - Pushed to right -->
        <Button onAction="#navigatetoLogin" style="-fx-background-color: #d5d5d5; -fx-background-radius: 5; -fx-font-size: 16; -fx-cursor: hand;" text="Logout">
            <HBox.margin>
                <Insets right="20.0" />
            </HBox.margin>
        </Button>

    </HBox>

    <!-- LEFT SIDEBAR - Anchored to left, below navbar, stretches to bottom -->
    <VBox layoutY="60.0" prefWidth="250.0" spacing="5.0" style="-fx-background-color: #1565C0; -fx-border-color: #d0d0d0; -fx-border-width: 0 1 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="60.0">

        <!-- Dashboard -->
        <Button alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #2C5EAD; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;" text="📊  Dashboard">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Button>

        <!-- Student Admission -->
        <Button alignment="CENTER_LEFT" onAction="#admissionButton" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;" text="🧾  Student Admission">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Button>

        <!-- Records -->
        <Button alignment="CENTER_LEFT" onAction="#recordsButton" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;" text="📑  Student Records">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Button>

        <!-- Timetable -->
        <Button alignment="CENTER_LEFT" onAction="#timetableButton" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;" text="📅  Timetable">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Button>

        <!-- Attendance -->
        <Button alignment="CENTER_LEFT" onAction="#attendanceButton" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;" text="📝  Attendance">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Button>

    </VBox>

    <!-- MAIN CONTENT - ScrollPane wrapping all content -->
    <ScrollPane fitToWidth="true" 
                hbarPolicy="NEVER"
                style="-fx-background: #f8fafc; -fx-border-color: transparent;"
                AnchorPane.bottomAnchor="0.0" 
                AnchorPane.leftAnchor="250.0" 
                AnchorPane.rightAnchor="0.0" 
                AnchorPane.topAnchor="60.0">

        <content>
            <AnchorPane minHeight="900.0" style="-fx-background-color: #f8fafc;">

                <!-- Dashboard Title -->
                <Label layoutX="30.0" layoutY="20.0" prefHeight="38.0" prefWidth="250.0" text="Dashboard Overview" textFill="#1F2937">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <!-- MCA Department Subtitle -->
                <Label layoutX="30.0" layoutY="55.0" text="MCA Department" textFill="#6B7280">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>

                <!-- Bar Chart Container -->
                <AnchorPane fx:id="chartContainer" layoutX="30.0" layoutY="90.0" prefHeight="320.0" prefWidth="700.0" style="-fx-background-color: white; -fx-background-radius: 8;" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" />

                <!-- Vision & Mission Image -->
                <ImageView fitHeight="156.0" fitWidth="622.0" layoutX="30.0" layoutY="430.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/Vission%20and%20mission.png" />
                    </image>
                </ImageView>

                <Label layoutX="30.0" layoutY="600.0" prefHeight="27.0" prefWidth="228.0" text="History of the Department" textFill="#6b7280">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>

                <ImageView fitHeight="200.0" fitWidth="800.0" layoutX="30.0" layoutY="635.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/MCA%20History%20of%20the%20Department.png" />
                    </image>
                </ImageView>

            </AnchorPane>
        </content>
    </ScrollPane>

</AnchorPane>